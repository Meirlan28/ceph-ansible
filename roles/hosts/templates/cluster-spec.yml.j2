# Generated by ceph-ansible; applied with `ceph orch apply -i`.
{% for h in ceph_hosts %}
service_type: host
hostname: {{ h }}
addr: {{ hostvars[h].ceph_public_ip }}
labels:
  - _admin
{% if h in groups['mons'] %}
  - mon
{% endif %}
{% if h in groups['mgrs'] | default([]) %}
  - mgr
{% endif %}
{% if h in groups['osds'] | default([]) %}
  - osd
{% endif %}
---
{% endfor %}
service_type: mon
placement:
  label: mon
---
service_type: mgr
placement:
  label: mgr
  count: {{ [ceph_mgr_count | int, groups['mgrs'] | length] | min }}
{% for h in groups['osds'] | default([]) %}
---
service_type: osd
service_id: {{ h }}
placement:
  hosts:
    - {{ h }}
spec:
  data_devices:
{% if hostvars[h].ceph_osd_devices | default([]) | length %}
    paths:
{% for d in hostvars[h].ceph_osd_devices %}
      - {{ d }}
{% endfor %}
{% else %}
    all: true
{% endif %}
{% endfor %}
