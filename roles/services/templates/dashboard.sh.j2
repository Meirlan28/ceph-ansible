#!/bin/bash
# Generated by ceph-ansible. Password is read from a file, never passed as an argument.
set -euo pipefail
if ! ceph mgr module ls --format json | python3 -c 'import json,sys; sys.exit(0 if "dashboard" in json.load(sys.stdin)["enabled_modules"] else 1)'; then
  ceph mgr module enable dashboard; echo CHANGED module
fi
if ! ceph config-key exists mgr/dashboard/crt >/dev/null 2>&1; then
  ceph dashboard create-self-signed-cert; echo CHANGED cert
fi
if ! ceph dashboard ac-user-show {{ ceph_dashboard_user | quote }} >/dev/null 2>&1; then
  ceph dashboard ac-user-create {{ ceph_dashboard_user | quote }} -i /mnt/lab/dashboard.pass administrator --force-password
  echo CHANGED user
{% if ceph_dashboard_reset_password %}
else
  ceph dashboard ac-user-set-password {{ ceph_dashboard_user | quote }} -i /mnt/lab/dashboard.pass --force-password
  echo CHANGED password
{% endif %}
fi
