#!/bin/bash
# Generated by ceph-ansible. Sets each option only when its value differs.
set -euo pipefail
apply() {
  local current
  current=$(ceph config get "$1" "$2" 2>/dev/null || true)
  if [ "$current" != "$3" ]; then ceph config set "$1" "$2" "$3"; echo "CHANGED $1 $2=$3"; fi
}
{% for c in ceph_config + ceph_config_extra %}
apply {{ c.who | quote }} {{ c.key | quote }} {{ c.value | string | quote }}
{% endfor %}
