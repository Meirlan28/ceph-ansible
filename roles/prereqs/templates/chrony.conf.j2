# Managed by ceph-ansible (ceph_ntp_mode: cluster).
# Ceph monitors need clocks within 50 ms of each other, so every Ceph host follows one LAN source:
# {{ ceph_bootstrap_host }}, which follows the upstream pool.
{% if inventory_hostname == ceph_bootstrap_host %}
{% for s in ceph_ntp_upstream %}
pool {{ s }} iburst
{% endfor %}
# Serve time to the other Ceph hosts, even before the upstream pool is reachable.
{% for h in ceph_hosts if h != ceph_bootstrap_host %}
allow {{ hostvars[h].ceph_public_ip }}
{% endfor %}
local stratum 10
makestep 1.0 3
{% else %}
# Poll often: VM clocks drift quickly. Step whenever the offset exceeds 100 ms.
server {{ hostvars[ceph_bootstrap_host].ceph_public_ip }} iburst minpoll 2 maxpoll 4 prefer
makestep 0.1 -1
{% endif %}
driftfile /var/lib/chrony/drift
rtcsync
keyfile /etc/chrony.keys
ntsdumpdir /var/lib/chrony
leapsectz right/UTC
logdir /var/log/chrony
