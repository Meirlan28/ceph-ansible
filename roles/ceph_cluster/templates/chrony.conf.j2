# Managed by Ansible (role ceph_cluster, tasks/time.yml).
{% if inventory_hostname == ntp_server %}
# Time source for the cluster: follows the upstream pool and serves the other nodes.
{% for s in ntp_upstream %}
pool {{ s }} iburst
{% endfor %}
{% for a in ntp_allow %}
allow {{ a }}
{% endfor %}
local stratum 10
makestep 1.0 3
{% else %}
# Follow the cluster time source over the LAN and poll it often. Step only at startup (> 1 s), otherwise
# slew: on a busy VM host single NTP samples can be off by hundreds of ms (the server VM was not
# scheduled), and stepping on those would make the clock jump back and forth.
server {{ hostvars[ntp_server].ceph_ip }} iburst minpoll 2 maxpoll 4 prefer
makestep 1.0 3
{% endif %}
driftfile /var/lib/chrony/drift
rtcsync
keyfile /etc/chrony.keys
ntsdumpdir /var/lib/chrony
leapsectz right/UTC
logdir /var/log/chrony
