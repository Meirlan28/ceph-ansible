#!/bin/bash
# Generated by ceph-ansible. Creates missing pools and enables their application.
set -euo pipefail
existing=$(ceph osd pool ls)
{% for p in ceph_pools %}
if ! grep -qx {{ p.name | quote }} <<< "$existing"; then
  ceph osd pool create {{ p.name | quote }} {{ p.pg_num | default(32) }}
{% if p.size is defined %}
  ceph osd pool set {{ p.name | quote }} size {{ p.size }}
{% endif %}
  echo CHANGED pool {{ p.name }}
fi
{% if p.application is defined %}
if ! ceph osd pool application get {{ p.name | quote }} | grep -q '"{{ p.application }}"'; then
  ceph osd pool application enable {{ p.name | quote }} {{ p.application | quote }}
{% if p.application == 'rbd' %}
  rbd pool init {{ p.name | quote }}
{% endif %}
  echo CHANGED application {{ p.name }}={{ p.application }}
fi
{% endif %}
{% endfor %}
